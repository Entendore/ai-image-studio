# AI Image Studio — environment configuration
# Copy to ".env" (next to the app, or in the data dir) or export in your shell.
# Precedence: real environment > .env file > app Settings > defaults.

# --- Paths ---
#AIIS_DATA_DIR=/path/to/data
#AIIS_LOG_DIR=/path/to/logs
#AIIS_OUTPUT_DIR=/path/to/output

# --- Logging / diagnostics ---
#AIIS_LOG_LEVEL=debug            # debug | info | warning | error
#AIIS_CONSOLE_LOG=1              # mirror logs to the console

# --- Behavior ---
#AIIS_THEME=dark                 # dark | light
#AIIS_BACKEND=demo               # demo | local | api   (great for CI)
#AIIS_DEVICE=cpu                 # auto | cpu | cuda
#AIIS_NO_UPDATES=1
#AIIS_ALLOW_MULTI=1
#AIIS_MAX_IMAGE_PIXELS=200000000

# --- Models (override the Models tab / Settings) ---
#AIIS_SD_MODEL=Lykon/dreamshaper-8
#AIIS_SD_INPAINT_MODEL=stabilityai/stable-diffusion-2-inpainting
#HF_TOKEN=hf_xxxxxxxxxxxx        # or HUGGING_FACE_HUB_TOKEN

# --- API ---
#OPENAI_API_KEY=sk-xxxxxxxx      # keyring-stored key still takes precedence
#OPENAI_BASE_URL=https://api.openai.com/v1
